# Приемная комиссия ЕПК - Конфигурация окружения

APP_NAME="Приемная комиссия ЕПК"
APP_VERSION="2.0.0"

# Данные для входа по умолчанию:
# admin / admin123 - Главный администратор
# osokin / 123456 - Ответственный секретарь
# tsygankova / 123456 - Зам. ответственного секретаря
# vorobyeva / 123456 - Специалист архива
# khanakova / 123456 - Специалист архива

# Настройки базы данных
DB_TYPE="localStorage"
STORAGE_PREFIX="receipt_system"

# Настройки приложения
DEFAULT_THEME="light"
ITEMS_PER_PAGE="20"
MAX_PHOTOS_COUNT="4"
RECEIPT_PREFIX="РАС"
COMPANY_PHONE="(499) 156-40-01"